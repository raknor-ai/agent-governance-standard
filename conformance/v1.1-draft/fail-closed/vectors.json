        "executed": false,
        "event": "policy_indeterminate",
        "event_detail": {
          "input": "allowlist",
          "received_value": null,
          "received_form": "null"
        }
      }
    },
    {
      "id": "a3-explicit-wildcard",
      "clause": "a",
