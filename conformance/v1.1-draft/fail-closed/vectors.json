{
  "schema": "raknor-v1.1-draft/fail-closed-policy-vectors/0.1",
  "proposal": "https://github.com/raknor-ai/agent-governance-standard/issues/3",
  "license": "CC0-1.0",
  "note": "Black-box: each vector is a policy state plus one requested action. Expected outcome is observable through the system API: whether the action executed, and whether a governance event (SC-OB-03) was emitted. Allowlist entries are exact action identifiers (namespace:name) or the single wildcard `*`; any other match-all spelling (\"all\", \"any\", a regex) is unrecognised, so the policy is indeterminate. A verdict object may carry `after_s` (when the approver answered) against the policy's `approver_deadline_s`: an explicit DENY before the deadline is a normal denial; no verdict by the deadline is indeterminate.",
  "vectors": [
    {"id": "a1-empty-allowlist", "clause": "a",
     "policy": {"allowlist": []}, "action": "tool:shell.exec", "verdict": "ALLOW",
     "expect": {"executed": false, "event": "policy_indeterminate"}},
    {"id": "a2-null-allowlist", "clause": "a",
     "policy": {"allowlist": null}, "action": "tool:shell.exec", "verdict": "ALLOW",
     "expect": {"executed": false, "event": "policy_indeterminate"}},
    {"id": "a3-explicit-wildcard", "clause": "a", "positive_control": true,
     "policy": {"allowlist": ["*"]}, "action": "tool:shell.exec", "verdict": "ALLOW",
     "expect": {"executed": true, "event": null}},
    {"id": "a4-listed-tool", "clause": "a", "positive_control": true,
     "policy": {"allowlist": ["tool:search"]}, "action": "tool:search", "verdict": "ALLOW",
     "expect": {"executed": true, "event": null}},
    {"id": "b0-verdict-explicit-deny", "clause": "b", "positive_control": true,
     "policy": {"allowlist": ["tool:search"]}, "action": "tool:search", "verdict": "DENY",
     "expect": {"executed": false, "event": null}},
    {"id": "b1-verdict-lowercase-deny", "clause": "b",
     "policy": {"allowlist": ["tool:search"]}, "action": "tool:search", "verdict": "deny",
     "expect": {"executed": false, "event": "policy_indeterminate"}},
    {"id": "b2-verdict-lowercase-allow", "clause": "b",
     "policy": {"allowlist": ["tool:search"]}, "action": "tool:search", "verdict": "allow",
     "expect": {"executed": false, "event": "policy_indeterminate"}},
    {"id": "b3-verdict-empty-string", "clause": "b",
     "policy": {"allowlist": ["tool:search"]}, "action": "tool:search", "verdict": "",
     "expect": {"executed": false, "event": "policy_indeterminate"}},
    {"id": "b4-verdict-null", "clause": "b",
     "policy": {"allowlist": ["tool:search"]}, "action": "tool:search", "verdict": null,
     "expect": {"executed": false, "event": "policy_indeterminate"}},
    {"id": "b5-verdict-unknown-token", "clause": "b",
     "policy": {"allowlist": ["tool:search"]}, "action": "tool:search", "verdict": "APPROVED_PENDING",
     "expect": {"executed": false, "event": "policy_indeterminate"}},
    {"id": "b6-alternative-wildcard-spelling", "clause": "b",
     "policy": {"allowlist": ["all"]}, "action": "tool:shell.exec", "verdict": "ALLOW",
     "expect": {"executed": false, "event": "policy_indeterminate"}},
    {"id": "c1-evaluator-raises", "clause": "c",
     "policy": {"allowlist": ["tool:search"]}, "action": "tool:search", "verdict": {"raise": "RuntimeError"},
     "expect": {"executed": false, "event": "policy_indeterminate"}},
    {"id": "c2-approver-timeout", "clause": "c",
     "policy": {"allowlist": ["tool:search"]}, "action": "tool:search", "verdict": {"timeout": true},
     "expect": {"executed": false, "event": "policy_indeterminate"}},
    {"id": "c3-explicit-deny-before-deadline", "clause": "c", "positive_control": true,
     "policy": {"allowlist": ["tool:search"], "approver_deadline_s": 30}, "action": "tool:search", "verdict": {"value": "DENY", "after_s": 10},
     "expect": {"executed": false, "event": null}},
    {"id": "c4-no-verdict-by-deadline", "clause": "c",
     "policy": {"allowlist": ["tool:search"], "approver_deadline_s": 30}, "action": "tool:search", "verdict": {"value": "ALLOW", "after_s": 45},
     "expect": {"executed": false, "event": "policy_indeterminate"}},
    {"id": "d1-policy-unparseable", "clause": "d",
     "policy": {"load_error": "parse"}, "action": "tool:search", "verdict": "ALLOW",
     "expect": {"executed": false, "event": "policy_indeterminate"}},
    {"id": "d2-policy-signature-invalid", "clause": "d",
     "policy": {"allowlist": ["*"], "signature_valid": false}, "action": "tool:search", "verdict": "ALLOW",
     "expect": {"executed": false, "event": "policy_indeterminate"}}
  ]
}
